# ============================================
# CARF — HOMOLOGAÇÃO (HML)
# ============================================
# 1. cp .env.example .env
# 2. Preencha VPS_IP e troque as senhas
# 3. docker compose up -d --build

# === VPS ===
VPS_IP=SEU_IP_AQUI

# === Ambiente ===
ENVIRONMENT=hml

# === PostgreSQL ===
POSTGRES_DB=carf_hml
POSTGRES_USER=carf_hml_user
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_1

# === Keycloak ===
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=TROCAR_SENHA_FORTE_2
KC_DB_PASSWORD=TROCAR_SENHA_FORTE_3

# === GEOAPI Keycloak Client (confidential) ===
KC_GEOAPI_CLIENT_SECRET=changeme

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROCAR_SENHA_FORTE_4

# === GitHub Packages (PAT with read:packages) ===
GITHUB_TOKEN=ghp_xxxx

# === Google Maps ===
GOOGLE_MAPS_KEY=YOUR_KEY_HERE
