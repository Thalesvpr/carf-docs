# ============================================
# CARF — HOMOLOGACAO (HML)
# ============================================
# 1. cp .env.example .env
# 2. Preencha VPS_IP e troque as senhas
# 3. docker compose up -d --build
# 4. Seguir POST-DEPLOY.md para configurar Keycloak

# === VPS ===
VPS_IP=SEU_IP_AQUI

# === Ambiente ===
ENVIRONMENT=hml

# === PostgreSQL ===
POSTGRES_DB=carf_hml
POSTGRES_USER=carf_hml_user
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_1

# === Keycloak ===
# ATENCAO: Essas credenciais so criam o admin no PRIMEIRO boot.
# Se mudar depois, precisa fazer bootstrap-admin (ver POST-DEPLOY.md).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=TROCAR_SENHA_FORTE_2
KC_DB_PASSWORD=TROCAR_SENHA_FORTE_3
KC_SEED_USER_PASSWORD=Dev@1234

# === GEOAPI Keycloak Client (confidential) ===
# Secret do client geoapi-admin no Keycloak.
# Valor padrao "changeme" vem do realm-export.json.
# Trocar em producao.
KC_GEOAPI_CLIENT_SECRET=changeme

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROCAR_SENHA_FORTE_4

# === GitHub Packages ===
# Token para baixar @carffundiaria/* do npm.pkg.github.com
# Precisa de scope: read:packages com acesso a org carffundiaria.
#
# Opcoes de token (em ordem de preferencia):
#   1. PAT classico (ghp_*) — github.com/settings/tokens/new
#      scope: read:packages, depois "Configure SSO" > Authorize carffundiaria
#   2. Token do gh CLI (gho_*) — rodar: gh auth token
#      Funciona se gh auth tem scope write:packages, MAS pode expirar
#
# Para testar se o token funciona:
#   curl -s -o /dev/null -w '%{http_code}' \
#     -H "Authorization: Bearer SEU_TOKEN" \
#     https://npm.pkg.github.com/@carffundiaria/ui
#   # Deve retornar 200 (ou 302). 401/403 = token sem acesso.
NPM_TOKEN=ghp_xxxx

# === Google Maps ===
GOOGLE_MAPS_KEY=YOUR_KEY_HERE
