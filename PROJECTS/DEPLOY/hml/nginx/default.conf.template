# CARF — HOMOLOGAÇÃO — Reverse Proxy (sslip.io)
# ${VPS_IP} substituído automaticamente pelo nginx envsubst

upstream geoapi        { server geoapi:8080; }
upstream keycloak      { server keycloak:8080; }
upstream reurbweb      { server reurbweb:80; }
upstream reurbmaster   { server reurbmaster:80; }
upstream minio-console { server minio:9001; }
upstream minio-api     { server minio:9000; }

# ─── GEOAPI ─────────────────────────────────────────
server {
    listen 80;
    server_name hml-api.${VPS_IP}.sslip.io;
    client_max_body_size 50M;

    # Header de ambiente em todas as respostas
    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://geoapi;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ─── Keycloak ────────────────────────────────────────
server {
    listen 80;
    server_name hml-auth.${VPS_IP}.sslip.io;
    client_max_body_size 10M;

    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://keycloak;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

# ─── REURBWEB ────────────────────────────────────────
server {
    listen 80;
    server_name hml-app.${VPS_IP}.sslip.io;

    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://reurbweb;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# ─── REURBMASTER ─────────────────────────────────────
server {
    listen 80;
    server_name hml-admin.${VPS_IP}.sslip.io;

    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://reurbmaster;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# ─── MinIO Console ───────────────────────────────────
server {
    listen 80;
    server_name hml-s3.${VPS_IP}.sslip.io;

    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://minio-console;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ─── MinIO API ───────────────────────────────────────
server {
    listen 80;
    server_name hml-storage.${VPS_IP}.sslip.io;
    client_max_body_size 100M;

    add_header X-Environment "HML" always;

    location / {
        proxy_pass http://minio-api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ─── Catch-all ───────────────────────────────────────
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
